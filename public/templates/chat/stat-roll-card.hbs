<div class="card clipped-bot" style="margin: 0px;">
  <div class="lancer-header lancer-primary">{{decorate-card (upper-case (localize "lancer.chatCard.title.check.label" check=title))}}</div>
  {{{lancer-dice-roll result.roll result.tt ""}}}
  {{#if effect}}
    <div class="lancer-header lancer-primary">{{decorate-card (upper-case (localize "lancer.common.descriptor.effect.label"))}}</div>
    <div class="effect-text">{{{effect}}}</div>
  {{/if}}
</div>
