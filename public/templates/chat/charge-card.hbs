<div class="card clipped">
  <div class="lancer-header lancer-primary">
    {{decorate-card (upper-case (localize "lancer.chatCard.title.recharging.label"))}}
  </div>
  {{{lancer-dice-roll result.roll result.tt "mdi mdi-refresh i--4"}}}
</div>
{{#if charged.length}}
  <div class="card clipped">
    <div class="lancer-header lancer-primary">
      {{decorate-card (upper-case (localize "lancer.chatCard.title.recharged.label"))}}
    </div>
    {{#each charged as |charge key|}}
      <div class="lancer-hit">
        <div class="lancer-hit-text">
          <span class="lancer-hit-text-name">
            {{charge.name}}
          </span>
          {{#if charge.charged}}
            <span class="card clipped lancer-charge-chip charged">
              {{upper-case (localize "lancer.chatCard.overcharge.charged.label" target=charge.target)}}
            </span>
          {{else}}
            <span class="card clipped lancer-charge-chip">
              {{upper-case (localize "lancer.chatCard.overcharge.uncharged.label" target=charge.target)}}
            </span>
          {{/if}}
        </div>
      </div>
    {{/each}}
  </div>
{{/if}}
