<div class="card clipped-bot" {{#if item_uuid}} data-uuid="{{item_uuid}}" {{/if}} style="margin: 0px">
  <div class="lancer-header lancer-tech tech medium">
    <i class="cci cci-tech-quick i--4 i--light"> </i>
    <span>
        {{#if invade}}
            {{upper-case (localize "lancer.common.activation.invade.label")}}
        {{else}}
            {{upper-case (localize "lancer.common.stat.tech.attack.short")}}
        {{/if}}{{#if title}} :: {{title}}{{/if}}</span>
    {{! TODO: refactor reroll button }}
    <!-- <a
      class="flow-button roll-attack lancer-button lancer-macro"
      data-macro="{{rerollMacroData}}"
      title="Reroll this attack"
    >
      <i class="fas fa-dice-d20 i--4 i--light"></i>
    </a> -->
  </div>
  {{#if profile}}
    {{{mini-profile profile}}}
  {{/if}}
  {{#if (not hit_results.length)}}
    <div class="card clipped">
      <div class="lancer-mini-header collapse-trigger" data-collapse-id="{{_uuid}}-attacks">
        {{decorate-card (upper-case (localize "lancer.common.attack.label"))}}
      </div>
      <div class="collapse" data-collapse-id="{{_uuid}}-attacks">
        {{#each attack_results as |attack key|}}
          {{{lancer-dice-roll attack.roll attack.tt "cci cci-reticule i--4"}}}
        {{/each}}
      </div>
    </div>
  {{/if}}
  {{#if hit_results.length}}
    <div class="lancer-mini-header collapse-trigger" data-collapse-id="{{_uuid}}-hits">
      {{decorate-card (upper-case (localize "lancer.chatCard.title.defenseHit.label" defense=defense))}}
    </div>
    <div class="collapse" data-collapse-id="{{_uuid}}-hits">
      {{#each hit_results as |hit key|}}
        {{{attack-target hit}}}
      {{/each}}
    </div>
  {{/if}}
  {{#if self_heat_result}}
    <div class="card clipped">
      <div class="lancer-mini-header collapse-trigger" data-collapse-id="{{_uuid}}-self-heat">
        {{decorate-card (upper-case (localize "lancer.chatCard.title.selfHeat.label"))}}
      </div>
      <div class="collapse" data-collapse-id="{{_uuid}}-self-heat">
        {{{lancer-dice-roll self_heat_result.roll self_heat_result.tt "cci cci-heat i--4 damage--heat"}}}
      </div>
    </div>
  {{/if}}
  {{#if effect}}
    <div class="card clipped">
      <div class="lancer-mini-header collapse-trigger" data-collapse-id="{{_uuid}}-effect">
        {{decorate-card (upper-case (localize "lancer.common.descriptor.effect.label"))}}
      </div>
      <span class="effect-text collapse" data-collapse-id="{{_uuid}}-effect">{{{effect}}}</span>
    </div>
  {{/if}}
  {{{tag-list "tags"}}}
  {{#if invade}}
    <button
      class="lancer-button lancer-damage-flow lancer-secondary"
      label="{{upper-case (localize "lancer.chatCard.attack.rollDamage.label")}}"
    >
      <i class="mdi mdi-dice-multiple i--3 i--light"></i>&nbsp;{{upper-case (localize "lancer.chatCard.attack.rollDamage.label")}}
    </button>
  {{/if}}
</div>
