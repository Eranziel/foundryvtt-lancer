<div class="card clipped-bot" style="margin: 0px">
  <div class="lancer-header lancer-reaction">{{decorate-card (upper-case title)}}</div>

  <div class="card clipped" style="padding: 5px">
    <div class="flexcol" style="margin: 10px">
      <span class="medium flexrow">{{localize "lancer.common.activation.trigger.label"}}</span>
      <div class="effect-text flexrow" style="padding: 5px">
        {{{trigger}}}
      </div>
      <span class="medium flexrow">{{localize "lancer.common.descriptor.effect.label"}}</span>
      <div class="effect-text flexrow" style="padding: 5px">
        {{{effect}}}
      </div>
    </div>
    {{{tag-list "tags"}}}
  </div>
</div>
