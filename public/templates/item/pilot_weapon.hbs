<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
  </header>
  <div class="flexcol">
    {{! Status }}
    <div class="card clipped">
      <div class="lancer-header lancer-primary major">{{localize "lancer.pilot-weapon.status"}}</div>
      <div class="flexrow" style="align-self: center">
        {{#if (is-loading item)}}
          {{{loading-indicator item "item"}}}
        {{/if}}
        {{#if (is-limited item)}}
          {{{limited-uses-indicator item "item"}}}
        {{/if}}
      </div>
    </div>

    {{! Weapon Stats }}
    {{!-- prettier-ignore --}}
    <div class="flexrow">
      {{{item-edit-arrayed-range        "system.range"     (localize "lancer.pilot-weapon.range")}}}
      {{{item-edit-arrayed-damage       "system.damage"    (localize "lancer.pilot-weapon.damage")}}}
    </div>

    {{{textarea-card (localize "lancer.pilot-weapon.description") "system.description"}}}
    {{{textarea-card (localize "lancer.pilot-weapon.effect") "system.effect"}}}

    {{! Bonuses }}
    {{!-- prettier-ignore --}}
    <div>
      {{{item-edit-arrayed-actions      "system.actions"        (localize "lancer.pilot-weapon.actions")}}}
      {{{item-edit-arrayed-bonuses      "system.bonuses"}}}
      {{{item-edit-arrayed-deployables  "system.deployables"    (localize "lancer.pilot-weapon.deployables")}}}
      {{{item-edit-arrayed-synergies    "system.synergies"      (localize "lancer.pilot-weapon.synergies")}}}
    </div>

    {{! Tags }}
    {{{item-edit-arrayed-tags "system.tags" (localize "lancer.pilot-weapon.tags")}}}
  </div>
</form>
