<form class="{{cssClass}}" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder='{{localize "lancer.placeholder.name"}}'
      >
    </h1>
    {{{ref-portrait-img item.img "img" system.}}}
    <div class="header-details">
      <input
        class="header-field"
        style="margin: 8px 2%; width: 96%"
        name="system.role"
        type="text"
        value="{{item.system.role}}"
        placeholder='{{localize "lancer.placeholder.npc_class_role"}}'
      >
    </div>
  </header>

  {{!-- Description --}}
  {{{textarea-card (upper-case (localize "lancer.common.descriptor.description.label")) "system.flavor"}}}
  {{{textarea-card (upper-case (localize "lancer.npcSheet.tactics.label")) "system.tactics"}}}

  {{!-- Frame Stats --}}
  <div class="card clipped wraprow quadruple">
    <div class="wraprow quadruple">
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.hull.label")) "system.base_stats" "hull"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.agility.label")) "system.base_stats" "agi"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.systems.label")) "system.base_stats" "sys"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.engineering.label")) "system.base_stats" "eng"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.armor.label")) "system.base_stats" "armor"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.hp.label")) "system.base_stats" "hp"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.structure.label")) "system.base_stats" "structure"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.stress.label")) "system.base_stats" "stress"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.evasion.label")) "system.base_stats" "evasion"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.eDefense.label")) "system.base_stats" "edef"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.heat.cap.label")) "system.base_stats" "heatcap"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.speed.label")) "system.base_stats" "speed"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.activation.plural")) "system.base_stats" "activations"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.sensor.range.label")) "system.base_stats" "sensor_range"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.save.target.label")) "system.base_stats" "save"}}}
      {{{npc-clicker-statblock-card (upper-case (localize "lancer.common.stat.size.label")) "system.base_stats" "size"}}}
    </div>
  </div>

  <div class="flexcol card clipped-top lancer-border-primary" style="margin: 10px">
    <div class="lancer-header lancer-primary major">
      <span class="major">{{upper-case (localize "lancer.npcSheet.features.base.label")}}</span>
    </div>

    {{{lid-item-list "system.base_features" base_features "npc_feature"}}}
  </div>

  <div class="flexcol card clipped-top lancer-border-primary" style="margin: 10px">
    <div class="lancer-header lancer-primary major">
      <span class="major">{{upper-case (localize "lancer.npcSheet.features.optional.label")}}</span>
    </div>

    {{{lid-item-list "system.optional_features" optional_features "npc_feature"}}}
  </div>
</form>
