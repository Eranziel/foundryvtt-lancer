<form class="{{cssClass}}" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder='{{localize "lancer.placeholder.name"}}'
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
    <div class="header-details">
      {{{item-edit-license}}}
    </div>
  </header>

  {{{textarea-card (upper-case (localize "lancer.common.descriptor.description.label")) "system.description"}}}

  {{!-- Frame Stats --}}
  <div class="card clipped wraprow quadruple">
    <div class="wraprow quadruple">
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.hp.short"))          "mdi mdi-heart-outline"     "system.stats.hp" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.armor.short"))       "mdi mdi-shield-outline"    "system.stats.armor" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.repair.short"))     "cci cci-repair"            "system.stats.repcap" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.evasion.short"))     "cci cci-evasion"           "system.stats.evasion" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.eDefense.short"))   "cci cci-edef"              "system.stats.edef" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.heat.cap.short"))    "cci cci-heatcap"           "system.stats.heatcap" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.speed.short"))       "mdi mdi-arrow-right-bold-hexagon-outline" "system.stats.speed" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.tech.attack.short")) "cci cci-tech-full"         "system.stats.tech_attack" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.sensor.short"))      "cci cci-sensor"            "system.stats.sensor_range" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.save.short"))        "cci cci-save"              "system.stats.save" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.mechSheet.system.points.short"))"cci cci-system"            "system.stats.sp" false}}}
      {{{clicker-stat-card (upper-case (localize "lancer.common.stat.size.short"))        "cci cci-hexagon"           "system.stats.size" false}}}
    </div>
  </div>

  {{!-- Mounts --}}
  <div class="flexcol">
    <div>
      <span class="minor" style="float: left">{{upper-case (localize "lancer.mechSheet.availableWeaponMounts.label")}}</span>
      <a
        class="gen-control"
        data-action="append"
        data-path="system.mounts"
        data-action-value="(struct)mount_type"
        style="float: right"
      >+</a>
    </div>
    <div class="flexrow">
      {{#each system.mounts as |mount key|}}
        <div class="flexrow mount arrayed-item">
          <select class="mount-selector" name="system.mounts.{{key}}" data-type="String" index="{{key}}">
            {{#select mount}}
              <option value="Aux/Aux">{{upper-case (localize "lancer.mechSheet.mountedWeapons.auxAux.label")}}</option>
              <option value="Main">{{upper-case (localize "lancer.mechSheet.mountedWeapons.main.label")}}</option>
              <option value="Main/Aux">{{upper-case (localize "lancer.mechSheet.mountedWeapons.mainAux.label")}}</option>
              <option value="Flex">{{upper-case (localize "lancer.mechSheet.mountedWeapons.flex.label")}}</option>
              <option value="Heavy">{{upper-case (localize "lancer.mechSheet.mountedWeapons.heavy.label")}}</option>
              <option value="Integrated">{{upper-case (localize "lancer.mechSheet.mountedWeapons.integrated.label")}}</option>
              <option value="Superheavy">{{upper-case (localize "lancer.mechSheet.mountedWeapons.superheavy.label")}}</option>
              <option value="delete">{{upper-case (localize "lancer.common.descriptor.delete.label")}}</option>
            {{/select}}
          </select>
        </div>
      {{/each}}
    </div>
  </div>

  {{!-- Traits --}}
  <div class="card">
    <div class="lancer-header lancer-primary">
      <span class="major left">{{localize "lancer.common.descriptor.trait.plural"}}</span>
      <a
        class="gen-control"
        data-action="append"
        data-path="system.traits"
        data-action-value="(struct)frame_trait"
        style="float: right"
      >+</a>
    </div>
    {{#each system.traits as |trait trait_index|}}
      <div class="card clipped lancer-trait">
        <div class="lancer-header lancer-trait major">
          <i class="cci cci-trait i--4 i--light header-icon"> </i>
          <input
            class="lancer-invisible-input i--light"
            name="system.traits.{{trait_index}}.name"
            value="{{trait.name}}"
            type="text"
            data-dtype="String"
          >
          {{{popout-editor-button (concat "system.traits." trait_index ".description")}}}
          <a class="gen-control" data-action="splice" data-path="system.traits.{{trait_index}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
        <div class="desc-text">{{{safe-html trait.description}}}</div>
        {{{bonuses-view (concat "system.traits." trait_index ".bonuses") ../editable}}}
      </div>
    {{/each}}
  </div>

  {{!-- Core System --}}
  <div class="card clipped-top frame_core lancer-border-bonus">
    {{!-- General Description --}}
    <div class="lancer-header lancer-bonus frame_core medium">
      <i></i>
      <input
        class="lancer-invisible-input major i--light"
        name="system.core_system.name"
        value="{{system.core_system.name}}"
        data-dtype="String"
      >
      <div class="medium faded" style="justify-self: right">// {{upper-case (localize "lancer.mechSheet.coreSystem.label")}}</div>
      {{{popout-editor-button "system.core_system.description"}}}
    </div>
    <div class="desc-text">{{{safe-html system.core_system.description}}}</div>

    {{!-- Integrated --}}
    <div class="integrated-wrapper card clipped flexcol">
      <div class="lancer-header lancer-primary">{{upper-case (localize "lancer.commonSheet.integratedGear.label")}}</div>
      <ul>
        {{#each system.core_system.integrated as |integrated index|}}
          <li>
            <code>
              {{integrated}}
            </code>
          </li>
        {{/each}}
        {{{item-edit-arrayed-deployables "system.core_system.deployables" (localize "lancer.common.actor.deployable.plural")}}}
      </ul>
    </div>

    {{!-- Passive Description + Bonuses --}}
    <div class="card clipped-top frame_core lancer-border-bonus">
      <div class="lancer-header lancer-bonus">
        <i class="mdi mdi-circle-expand i--4 i--light"> </i>
        <input
          class="lancer-invisible-input medium i--light"
          name="system.core_system.passive_name"
          value="{{system.core_system.passive_name}}"
          data-dtype="String"
        >
        <div class="medium faded" style="justify-self: right">
          // {{localize "lancer.common.descriptor.passive.label"}}
        </div>
        {{{popout-editor-button "system.core_system.passive_effect"}}}
      </div>
      <div class="desc-text">{{{safe-html system.core_system.passive_effect}}}</div>
      {{{bonuses-view "system.core_system.passive_bonuses" editable}}}
      {{#each system.core_system.passive_actions as |action index|}}
        <!-- todo action-->
      {{/each}}
    </div>

    {{!-- Active Description + Bonuses --}}
    <div class="card clipped-top frame_core lancer-border-bonus">
      <div class="lancer-header lancer-bonus">
        <i class="cci cci-corebonus i--4 i--light"> </i>
        <input
          class="lancer-invisible-input medium i--light"
          name="system.core_system.active_name"
          value="{{system.core_system.active_name}}"
          data-dtype="String"
        >
        <div class="faded" style="justify-self: right">// {{localize "lancer.common.descriptor.active.label"}}</div>
        {{{popout-editor-button "system.core_system.active_effect"}}}
      </div>
      <div class="desc-text">{{{safe-html system.core_system.active_effect}}}</div>
      {{{bonuses-view "system.core_system.active_bonuses" editable}}}
      {{#each system.core_system.active_actions as |action index|}}
        <!-- todo action-->
      {{/each}}
    </div>
    {{{item-edit-arrayed-tags "system.core_system.tags" (upper-case (localize "lancer.common.descriptor.tag.plural"))}}}
  </div>
</form>
