{{! TODO: this template is unused, but might serve as a starting point for
  a tag setting editor }}

<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
  </header>

  {{! Sheet Body }}
  <section class="sheet-body">
    {{{textarea-card (upper-case (localize "lancer.common.descriptor.description.label")) "system.description"}}}
    <div class="card">
      <span class="lancer-header lancer-primary">{{{upper-case (localize "lancer.itemSheet.tag.metaInfo.label")}}}</span>
      {{{std-text-input "system.lid" label="LID:"}}} <!-- Don't localize -->
      {{{std-checkbox "system.hidden" label=(concat (upper-case (localize "lancer.common.descriptor.hidden.label")) ":") label_classes="self-left"}}}
      {{{std-checkbox "system.filterIgnore" label=(concat (upper-case (localize "lancer.itemSheet.tag.filterIgnore.label")) ":") label_classes="self-left"}}}
    </div>
  </section>
</form>
