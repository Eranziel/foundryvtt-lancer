<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    <div class="header-details origin_type">
      <span class="medium">{{upper-case (localize "lancer.npcSheet.features.type.label")}}: </span>
      <select class="header-field" name="system.type" data-type="String">
        {{#select system.type}}
          <option class="i--dark" value="Reaction">
            {{{upper-case (localize "lancer.common.activation.reaction.label")}}}
          </option>
          <option class="i--dark" value="System">
            {{{upper-case (localize "lancer.common.item.mechSystem.label")}}}
          </option>
          <option class="i--dark" value="Tech">
            {{{upper-case (localize "lancer.common.stat.tech.attack.label")}}}
          </option>
          <option class="i--dark" value="Trait">
            {{{upper-case (localize "lancer.common.descriptor.trait.label")}}}
          </option>
          <option class="i--dark" value="Weapon">
            {{{upper-case (localize "lancer.common.item.mechWeapon.label")}}}
          </option>
        {{/select}}
      </select>
    </div>
    {{{ref-portrait-img item.img "img" item}}}
  </header>
  {{! Sheet Body }}
  <section class="sheet-body">
    <div class="effect-box">
      <div class="effect-title clipped-bot">{{upper-case (localize "lancer.common.descriptor.source.label")}}</div>
      <div class="effect-text flexrow">
        <div class="origin-name">
          <input
            name="system.origin.name"
            type="text"
            value="{{system.origin.name}}"
            placeholder="{{localize "lancer.npcSheet.sourceName.label"}}"
          >
        </div>
        <div class="origin-type flexrow">
          <select name="system.origin.type" data-type="text">
            {{#select system.origin.type}}
              <option class="i--dark" value="Class">
                {{upper-case (localize "lancer.npcSheet.class.label")}}
              </option>
              <option class="i--dark" value="Template">
                {{upper-case (localize "lancer.npcSheet.templates.label")}}
              </option>
            {{/select}}
          </select>
        </div>
        <div class="origin_base flexrow" style="align-items: center">
          <span class="medium" style="text-align: right">
            {{#if system.origin.base}}
              {{upper-case (localize "lancer.npcSheet.features.base.label")}}
            {{else}}
              {{upper-case (localize "lancer.npcSheet.features.optional.label")}}
            {{/if}}
          </span>
          <input type="checkbox" name="system.origin.base" {{checked system.origin.base}}>
        </div>
      </div>
    </div>
    {{! Limited Uses Tracking }}
    {{#if (is-limited item)}}
      <div class="flexrow stat-container" style="align-self: center; margin: 5px 30px; max-width: max-content">
        <span class="medium">
          {{upper-case (localize "lancer.common.descriptor.use.plural")}}:
        </span>
        <input
          class="lancer-stat major"
          type="number"
          name="system.uses"
          value="{{system.uses}}"
          data-dtype="Number"
        >
        <span class="medium" style="max-width: min-content">
          /
        </span>
        <span class="lancer-stat major" type="number">
          {{system.maxUses}}
        </span>
      </div>
    {{/if}}
    {{! Reaction }}
    {{#if (eq system.type "Reaction")}}
      {{{textarea-card (upper-case (localize "lancer.common.activation.trigger.label")) "system.trigger"}}}{{{textarea-card (upper-case (localize "lancer.common.descriptor.effect.label")) "system.effect"}}}
    {{/if}}
    {{! System }}
    {{#if (eq system.type "System")}}
      {{{textarea-card (upper-case (localize "lancer.common.descriptor.effect.label")) "system.effect"}}}
    {{/if}}
    {{! Trait }}
    {{#if (eq system.type "Trait")}}
      {{{textarea-card (upper-case (localize "lancer.common.descriptor.effect.label")) "system.effect"}}}
    {{/if}}
    {{! Tech }}
    {{#if (eq system.type "Tech")}}
      <div class="wraprow triple">
        <div class="flexcol">
          <div class="flexrow" style="align-items: center">
            <span class="medium" style="text-align: right; max-width: fit-content; padding-right: 1em">
              {{{upper-case (localize "lancer.common.stat.tech.label")}}}
            </span>
            <select name="system.techType" data-type="String" style="align-self: center">
              {{#select system.techType}}
                <option value="Quick">
                  {{{upper-case (localize "lancer.common.activation.quickTech.label")}}}
                </option>
                <option value="Full">
                  {{{upper-case (localize "lancer.common.activation.fullTech.label")}}}
                </option>
              {{/select}}
            </select>
          </div>
          <div class="flexrow" style="align-items: center">
            <span class="medium" style="text-align: right; max-width: fit-content; padding-right: 1em">
              {{{upper-case (localize "lancer.common.stat.tech.attack.label")}}}?
            </span>
            <input type="checkbox" name="system.tech_attack" {{checked system.tech_attack}}>
          </div>
        </div>
        {{#if system.tech_attack}}
          {{{npc-clicker-statarr-card (upper-case (localize "lancer.common.attack.bonus.label")) "system.attack_bonus"}}}
          {{{npc-clicker-statarr-card (upper-case (localize "lancer.common.attack.accuracy.label")) "system.accuracy"}}}
        {{/if}}
        {{{textarea-card (upper-case (localize "lancer.common.descriptor.effect.label")) "system.effect"}}}
      </div>
    {{/if}}
    {{! Weapon }}
    {{#if (eq system.type "Weapon")}}
      <div class="wraprow triple">
        {{! Type }}
        <div class="card clipped">
          <span class="lancer-header lancer-primary major">
            TYPE
          </span>
          {{! Can't use the weapon type/size selectors because NPC weapons only have
              a single string field that combines both }}
          <input
            class="lancer-stat"
            type="text"
            name="system.weapon_type"
            value="{{system.weapon_type}}"
            data-dtype="String"
          >
        </div>
        <div class="double"></div>
        {{! Range }}
        <div class="card clipped">
          <span class="lancer-header lancer-primary major">
            RANGE
            <a
              class="gen-control"
              data-action="append"
              data-path="system.range"
              data-action-value="(struct)range"
              style="float: right"
            >
              +
            </a>
          </span>
          {{#each system.range as |range range_index|}}
            {{{wpn-range-sel (concat "system.range." range_index)}}}
          {{/each}}
        </div>
        {{! Attack Bonus }}
        {{{npc-clicker-statarr-card (upper-case (localize "lancer.common.attack.bonus.label")) "system.attack_bonus"}}}
        {{! Accuracy }}
        {{{npc-clicker-statarr-card (upper-case (localize "lancer.common.attack.accuracy.label")) "system.accuracy"}}}
        {{! All Damages }}
        {{#each system.damage as |tier_damage_array tier_index|}}
          <div class="card clipped">
            <span class="lancer-header lancer-primary major">
              <i class="cci cci-npc-tier-{{inc tier_index}} i--4 i--dark"></i>
              {{{localize "lancer.common.stat.tier.short"}}}{{inc tier_index}}
              {{{upper-case (localize "lancer.common.attack.damage.label")}}}
              <a class="npc-damage-append" style="float: right">
                +
              </a>
            </span>
            {{#each tier_damage_array as |damage damage_index|}}
              {{{wpn-damage-sel (concat "system.damage." tier_index "." damage_index)}}}
            {{/each}}
          </div>
        {{/each}}
        {{! Effects }}
        {{{textarea-card (upper-case (localize "lancer.common.activation.onHit.label")) "system.on_hit"}}}
        {{{textarea-card (upper-case (localize "lancer.common.descriptor.effect.label")) "system.effect"}}}
      </div>
    {{/if}}
    {{{item-edit-arrayed-tags "system.tags" (upper-case (localize "lancer.common.descriptor.tag.plural"))}}}
  </section>
</form>
