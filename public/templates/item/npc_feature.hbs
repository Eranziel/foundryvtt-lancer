<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    <div class="header-details origin_type">
      <span class="medium">{{localize "lancer.npc-feature.feature-type"}}: </span>
      <select class="header-field" name="system.type" data-type="String">
        {{#select system.type}}
          <option class="i--dark" value="Reaction">
            {{localize "lancer.npc-feature.type.reaction"}}
          </option>
          <option class="i--dark" value="System">
            {{localize "lancer.npc-feature.type.system"}}
          </option>
          <option class="i--dark" value="Tech">
            {{localize "lancer.npc-feature.type.tech"}}
          </option>
          <option class="i--dark" value="Trait">
            {{localize "lancer.npc-feature.type.trait"}}
          </option>
          <option class="i--dark" value="Weapon">
            {{localize "lancer.npc-feature.type.weapon"}}
          </option>
        {{/select}}
      </select>
    </div>
    {{{ref-portrait-img item.img "img" item}}}
  </header>
  {{! Sheet Body }}
  <section class="sheet-body">
    <div class="effect-box">
      <div class="effect-title clipped-bot">{{localize "lancer.npc-feature.source"}}</div>
      <div class="effect-text flexrow">
        <div class="origin-name">
          <input
            name="system.origin.name"
            type="text"
            value="{{system.origin.name}}"
            placeholder="{{localize 'lancer.placeholder.origin_name'}}"
          >
        </div>
        <div class="origin-type flexrow">
          <select name="system.origin.type" data-type="text">
            {{#select system.origin.type}}
              <option class="i--dark" value="Class">
                {{localize "lancer.npc-feature.origin.class"}}
              </option>
              <option class="i--dark" value="Template">
                {{localize "lancer.npc-feature.origin.template"}}
              </option>
            {{/select}}
          </select>
        </div>
        <div class="origin_base flexrow" style="align-items: center">
          <span class="medium" style="text-align: right">
            {{#if system.origin.base}}
              {{localize "lancer.npc-feature.base-feature"}}
            {{else}}
              {{localize "lancer.npc-feature.optional-feature"}}
            {{/if}}
          </span>
          <input type="checkbox" name="system.origin.base" {{checked system.origin.base}}>
        </div>
      </div>
    </div>
    {{! Limited Uses Tracking }}
    {{#if (is-limited item)}}
      <div class="flexrow stat-container" style="align-self: center; margin: 5px 30px; max-width: max-content">
        <span class="medium">
          {{localize "lancer.npc-feature.uses"}}:
        </span>
        <input
          class="lancer-stat major"
          type="number"
          name="system.uses"
          value="{{system.uses}}"
          data-dtype="Number"
        >
        <span class="medium" style="max-width: min-content">
          /
        </span>
        <span class="lancer-stat major" type="number">
          {{system.maxUses}}
        </span>
      </div>
    {{/if}}
    {{! Reaction }}
    {{#if (eq system.type "Reaction")}}
      {{{textarea-card (localize "lancer.npc-feature.trigger") "system.trigger"}}}{{
        {textarea-card (localize "lancer.npc-feature.effect") "system.effect"}
      }}
    {{/if}}
    {{! System }}
    {{#if (eq system.type "System")}}
      {{{textarea-card (localize "lancer.npc-feature.effect") "system.effect"}}}
    {{/if}}
    {{! Trait }}
    {{#if (eq system.type "Trait")}}
      {{{textarea-card (localize "lancer.npc-feature.effect") "system.effect"}}}
    {{/if}}
    {{! Tech }}
    {{#if (eq system.type "Tech")}}
      <div class="wraprow triple">
        <div class="flexcol">
          <div class="flexrow" style="align-items: center">
            <span class="medium" style="text-align: right; max-width: fit-content; padding-right: 1em">
              {{localize "lancer.npc-feature.tech"}}
            </span>
            <select name="system.techType" data-type="String" style="align-self: center">
              {{#select system.techType}}
                <option value="Quick">
                  {{localize "lancer.npc-feature.quick"}}
                </option>
                <option value="Full">
                  {{localize "lancer.npc-feature.full"}}
                </option>
              {{/select}}
            </select>
          </div>
          <div class="flexrow" style="align-items: center">
            <span class="medium" style="text-align: right; max-width: fit-content; padding-right: 1em">
              {{localize "lancer.npc-feature.is-tech-attack"}}
            </span>
            <input type="checkbox" name="system.tech_attack" {{checked system.tech_attack}}>
          </div>
        </div>
        {{#if system.tech_attack}}
          {{{npc-clicker-statarr-card "attack_bonus" "system.attack_bonus"}}}
          {{{npc-clicker-statarr-card "accuracy" "system.accuracy"}}}
        {{/if}}
        {{{textarea-card (localize "lancer.npc-feature.effect") "system.effect"}}}
      </div>
    {{/if}}
    {{! Weapon }}
    {{#if (eq system.type "Weapon")}}
      <div class="wraprow triple">
        {{! Type }}
        <div class="card clipped">
          <span class="lancer-header lancer-primary major">
            {{localize "lancer.npc-feature.weapon-type"}}
          </span>
          {{! Can't use the weapon type/size selectors because NPC weapons only have
              a single string field that combines both }}
          <input
            class="lancer-stat"
            type="text"
            name="system.weapon_type"
            value="{{system.weapon_type}}"
            data-dtype="String"
          >
        </div>
        <div class="double"></div>
        {{! Range }}
        <div class="card clipped">
          <span class="lancer-header lancer-primary major">
            {{localize "lancer.npc-feature.range"}}
            <a
              class="gen-control"
              data-action="append"
              data-path="system.range"
              data-action-value="(struct)range"
              style="float: right"
            >
              +
            </a>
          </span>
          {{#each system.range as |range range_index|}}
            {{{wpn-range-sel (concat "system.range." range_index)}}}
          {{/each}}
        </div>
        {{! Attack Bonus }}
        {{{npc-clicker-statarr-card "attack_bonus" "system.attack_bonus"}}}
        {{! Accuracy }}
        {{{npc-clicker-statarr-card "accuracy" "system.accuracy"}}}
        {{! All Damages }}
        {{#each system.damage as |tier_damage_array tier_index|}}
          <div class="card clipped">
            <span class="lancer-header lancer-primary major">
              <i class="cci cci-npc-tier-{{inc tier_index}} i--4 i--dark"></i>
              T{{inc tier_index}}
              {{localize "lancer.npc-feature.damage"}}
              <a class="npc-damage-append" style="float: right">
                +
              </a>
            </span>
            {{#each tier_damage_array as |damage damage_index|}}
              {{{wpn-damage-sel (concat "system.damage." tier_index "." damage_index)}}}
            {{/each}}
          </div>
        {{/each}}
        {{! Effects }}
        {{{textarea-card (localize "lancer.npc-feature.on-hit-effect") "system.on_hit"}}}
        {{{textarea-card (localize "lancer.npc-feature.effect") "system.effect"}}}
      </div>
    {{/if}}
    {{{item-edit-arrayed-tags "system.tags" (localize "lancer.npc-feature.tags")}}}
  </section>
</form>
