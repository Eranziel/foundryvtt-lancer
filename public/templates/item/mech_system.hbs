<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
    <div class="header-details">
      {{{item-edit-license}}}
    </div>
  </header>

  <div class="card">
    <div class="lancer-header lancer-primary stretch">
      <!-- Put all the system metadata up here -->
      {{{item-edit-sp "system.sp"}}}
      <div>
        {{{sys-type-sel "system.type"}}}
      </div>
    </div>

    {{! Status }}
    <div class="card clipped">
      <div class="lancer-header lancer-primary major">{{localize "lancer.mech-system.status"}}</div>
      <div class="flexrow" style="align-self: center">
        {{#if (is-limited item)}}
          {{{limited-uses-indicator item "item"}}}
        {{/if}}
      </div>
    </div>

    {{{textarea-card (localize "lancer.mech-system.description") "system.description"}}}
    {{{textarea-card (localize "lancer.mech-system.effect") "system.effect"}}}

    {{! Bonuses }}
    {{!-- prettier-ignore --}}
    <div>
      {{{item-edit-arrayed-actions      "system.actions"       (localize "lancer.mech-system.actions")}}}
      {{{item-edit-arrayed-bonuses      "system.bonuses"}}}
      {{{counter-array system.counters  "system.counters"      true}}}
      {{{item-edit-arrayed-deployables  "system.deployables"   (localize "lancer.mech-system.deployables")}}}
      {{{item-edit-arrayed-synergies    "system.synergies"     (localize "lancer.mech-system.synergies")}}}
      {{{item-edit-arrayed-integrated   "system.integrated"    (localize "lancer.mech-system.integrated")}}}
    </div>

    {{{item-edit-arrayed-tags "system.tags" (localize "lancer.mech-system.tags")}}}
  </div>
</form>
