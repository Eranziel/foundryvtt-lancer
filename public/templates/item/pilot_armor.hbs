<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
  </header>

  {{{textarea-card (localize "lancer.pilot-armor.description") "system.description"}}}

  {{{textarea-card (localize "lancer.pilot-armor.effect") "system.effect"}}}

  {{! Uses }}
  <div>
    {{#if (is-limited item)}}
      {{{item-edit-uses "system.uses.value" "system.uses.max"}}}
    {{/if}}
  </div>

  {{! Bonuses }}
  {{{item-edit-arrayed-actions "system.actions" (localize "lancer.pilot-armor.actions")}}}
  {{{item-edit-arrayed-bonuses "system.bonuses"}}}
  {{{item-edit-arrayed-deployables "system.deployables" (localize "lancer.pilot-armor.deployables")}}}
  {{{item-edit-arrayed-synergies "system.synergies" (localize "lancer.pilot-armor.synergies")}}}

  {{{item-edit-arrayed-tags "system.tags" (localize "lancer.pilot-armor.tags")}}}
</form>
