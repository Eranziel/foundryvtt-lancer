<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
  </header>

  {{{textarea-card (upper-case (localize "lancer.common.descriptor.description.label")) "system.description"}}}

  {{{textarea-card (upper-case (localize "lancer.common.descriptor.effect.label")) "system.effect"}}}

  {{! Uses }}
  <div>
    {{#if (is-limited item)}}
      {{{item-edit-uses "system.uses.value" "system.uses.max"}}}
    {{/if}}
  </div>

  {{! Bonuses }}
  {{{item-edit-arrayed-actions "system.actions" (upper-case (localize "lancer.common.descriptor.action.plural"))}}}
  {{{item-edit-arrayed-bonuses "system.bonuses"}}}
  {{{item-edit-arrayed-deployables "system.deployables" (upper-case (localize "lancer.common.actor.deployable.plural"))}}}
  {{{item-edit-arrayed-synergies "system.synergies" (upper-case (localize "lancer.commonSheet.synergies.label"))}}}

  {{{item-edit-arrayed-tags "system.tags" (upper-case (localize "lancer.common.descriptor.tag.plural"))}}}
</form>
