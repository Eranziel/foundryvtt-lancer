<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
  </header>

  {{! Sheet Body }}
  <div class="flexcol">
    {{{textarea-card (localize "lancer.core-bonus.description") "system.description"}}}
    {{{textarea-card (localize "lancer.core-bonus.effect") "system.effect"}}}
    {{{textarea-card (localize "lancer.core-bonus.mounted-effect") "system.mountedEffect"}}}
    {{{item-edit-arrayed-actions "system.actions" (localize "lancer.core-bonus.actions")}}}
    {{{item-edit-arrayed-bonuses "system.bonuses"}}}
    {{{item-edit-arrayed-synergies "system.synergies" (localize "lancer.core-bonus.synergies")}}}
    {{{item-edit-arrayed-deployables "system.deployables" (localize "lancer.core-bonus.deployables")}}}
    {{{counter-array system.counters "system.counters" true}}}
    {{{item-edit-arrayed-integrated "system.integrated" (localize "lancer.core-bonus.integrated")}}}
  </div>
</form>
