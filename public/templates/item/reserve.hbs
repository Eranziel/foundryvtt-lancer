<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
  </header>

  {{! Sheet Body }}
  <section class="sheet-body">
    {{{textarea-card (upper-case (localize "lancer.itemSheet.reserve.resourceLabel.label")) "system.label"}}}
    {{{textarea-card (upper-case (localize "lancer.common.descriptor.description.label")) "system.description"}}}
    <div class="flexrow">
      <div class="card clipped">
        <div class="lancer-header lancer-primary">{{{upper-case (localize "lancer.common.descriptor.type.label")}}}</div>
        {{{item-edit-enum "system.type" "ReserveType" label=""}}}
      </div>
      <div class="card clipped" style="align-items: center">
        <div class="lancer-header lancer-primary">{{{upper-case (localize "lancer.common.descriptor.consumable.label")}}}</div>
        <input type="checkbox" name="system.consumable" {{checked system.consumable}}>
      </div>
      {{#if system.consumable}}
        {{{reserve-used-indicator "system.used"}}}
      {{/if}}
    </div>
  </section>
</form>
