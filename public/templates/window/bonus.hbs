<form class="{{cssClass}}" onsubmit="event.preventDefault()">
  <div class="card flexcol">
    <span class="lancer-header lancer-primary">{{localize "lancer.bonus.edit-bonus"}}</span>
    {{{std-text-input "lid" label=(localize "lancer.bonus.id") default=value.lid}}}
    {{{std-text-input "val" label=(localize "lancer.bonus.value") default=value.val}}}
    {{{std-checkbox "overwrite" label=(localize "lancer.bonus.overwrite") default=value.overwrite}}}
    {{{std-checkbox "replace" label=(localize "lancer.bonus.replace") default=value.replace}}}

    <div class="wraprow double">
      <div class="flexcol">
        <span class="lancer-header lancer-primary">{{localize "lancer.bonus.damage-types"}}</span>
        {{#each damages as |dmg index|}}
          {{{std-checkbox dmg.key label=dmg.label default=dmg.val}}}
        {{/each}}
      </div>
      <div class="flexcol">
        <span class="lancer-header lancer-primary">{{localize "lancer.bonus.range-types"}}</span>
        {{#each ranges as |range index|}}
          {{{std-checkbox range.key label=range.label default=range.val}}}
        {{/each}}
      </div>

      <div class="flexcol">
        <span class="lancer-header lancer-primary">{{localize "lancer.bonus.weapon-types"}}</span>
        {{#each types as |type index|}}
          {{{std-checkbox type.key label=type.label default=type.val}}}
        {{/each}}
      </div>
      <div class="flexcol">
        <span class="lancer-header lancer-primary">{{localize "lancer.bonus.weapon-sizes"}}</span>
        {{#each sizes as |size index|}}
          {{{std-checkbox size.key label=size.label default=size.val}}}
        {{/each}}
      </div>
    </div>
    {{> dialog-save-buttons}}
  </div>
</form>
