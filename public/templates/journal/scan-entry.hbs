<div class="scan-result" style="padding: 5px">
  <div class="scan-classes">
    {{localize "lancer.scan.tier"}}
    {{tier}}
    {{class}}
    {{#if templates.length}}
      ::
      {{#each templates as |template|}}
        {{template}}
      {{/each}}
    {{/if}}
  </div>
  <div class="scan-img-stat-container">
    <img src="{{img}}">
    <div class="scan-stat-grid">
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.hull'}}">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-h-box-outline"></i>
        </div>
        {{stats.hull}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.agility'}}">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-a-box-outline"></i>
        </div>
        {{stats.agi}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.systems'}}">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-s-box-outline"></i>
        </div>
        {{stats.sys}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.engineering'}}">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-e-box-outline"></i>
        </div>
        {{stats.eng}}
      </div>

      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.structure'}}">
        <div class="scan-stat-header">
          <i class="cci cci-structure"></i>
        </div>
        {{stats.structure}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.max_hp'}}">
        <div class="scan-stat-header">
          <i class="mdi mdi-heart-outline"></i>
        </div>
        {{stats.hp}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.evasion'}}">
        <div class="scan-stat-header">
          <i class="cci cci-evasion"></i>
        </div>
        {{stats.evasion}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.armor'}}">
        <div class="scan-stat-header">
          <i class="mdi mdi-shield-outline"></i>
        </div>
        {{stats.armor}}
      </div>

      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.stress'}}">
        <div class="scan-stat-header">
          <i class="cci cci-reactor"></i>
        </div>
        {{stats.stress}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.heat_cap'}}">
        <div class="scan-stat-header">
          <i class="cci cci-heat"></i>
        </div>
        {{stats.heat}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.edefense'}}">
        <div class="scan-stat-header">
          <i class="cci cci-edef"></i>
        </div>
        {{stats.edef}}
      </div>
      <div
        class="scan-stat-item stat-size"
        data-tooltip="{{localize 'lancer.scan.size'}} {{stats.size}}"
        style="grid-area: size"
      >
        {{#if (eq stats.size 0.5)}}
          <i class="cci cci-size-half"></i>
        {{else}}
          <i class="cci cci-size-{{stats.size}}"></i>
        {{/if}}
      </div>

      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.speed'}}">
        <div class="scan-stat-header">
          <i class="mdi mdi-arrow-right-bold-hexagon-outline"></i>
        </div>
        {{stats.speed}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.save_target'}}">
        <div class="scan-stat-header">
          <i class="cci cci-save"></i>
        </div>
        {{stats.save}}
      </div>
      <div class="scan-stat-item" data-tooltip="{{localize 'lancer.scan.sensor_range'}}">
        <div class="scan-stat-header">
          <i class="cci cci-sensor"></i>
        </div>
        {{stats.sensor_range}}
      </div>
    </div>
  </div>
  <div class="scan-weapon-tech-container flexrow">
    {{#if weapons}}
      <details open class="clipped-top scan-feature-list lancer-weapon lancer-border-weapon">
        <summary class="lancer-header">
          <i class="cci cci-weapon i--4"></i><span>{{localize "lancer.scan.weapons"}}</span><i
            class="mdi mdi-unfold-less-horizontal"
          ></i>
        </summary>
        <ul>
          {{#each weapons as |weapon index|}}
            {{{scan-weapon-view weapon}}}
          {{/each}}
        </ul>
      </details>
    {{/if}}
    {{#if techAttacks}}
      <details open class="clipped-top scan-feature-list lancer-tech lancer-border-tech">
        <summary class="lancer-header">
          <i class="cci cci-system i--4"></i><span>{{localize "lancer.scan.tech_attacks"}}</span><i
            class="mdi mdi-unfold-less-horizontal"
          ></i>
        </summary>
        <ul>
          {{#each techAttacks as |techAttack index|}}
            {{{scan-tech-attack-view techAttack}}}
          {{/each}}
        </ul>
      </details>
    {{/if}}
  </div>
  {{#if systems}}
    <details open class="clipped-top scan-feature-list lancer-system lancer-border-system">
      <summary class="lancer-header">
        <i class="cci cci-system i--4"></i><span>{{localize "lancer.scan.system_header"}}</span><i
          class="mdi mdi-unfold-less-horizontal"
        ></i>
      </summary>
      <ul>
        {{#each systems as |system index|}}
          {{{scan-system-view system}}}
        {{/each}}
      </ul>
    </details>
  {{/if}}
  {{#if traits}}
    <details open class="clipped-top scan-feature-list lancer-trait lancer-border-trait">
      <summary class="lancer-header">
        <i class="cci cci-trait i--4"></i><span>{{localize "lancer.scan.traits"}}</span><i
          class="mdi mdi-unfold-less-horizontal"
        ></i>
      </summary>
      <ul>
        {{#each traits as |trait index|}}
          {{{scan-system-view trait}}}
        {{/each}}
      </ul>
    </details>
  {{/if}}
</div>
