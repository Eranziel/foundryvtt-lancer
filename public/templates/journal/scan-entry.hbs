<div class="scan-result" style="padding: 5px">
  <div class="scan-classes">
    TIER {{tier}}
    {{class}}
    {{#if templates.length}}
      ::
      {{#each templates as |template|}}
        {{template}}
      {{/each}}
    {{/if}}
  </div>
  <div class="scan-img-stat-container">
    <img src="{{img}}">
    <div class="scan-stat-grid">
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.hull.label">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-h-box-outline"></i>
        </div>
        {{stats.hull}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.agility.label">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-a-box-outline"></i>
        </div>
        {{stats.agi}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.systems.label">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-s-box-outline"></i>
        </div>
        {{stats.sys}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.engineering.label">
        <div class="scan-stat-header">
          <i class="mdi mdi-alpha-e-box-outline"></i>
        </div>
        {{stats.eng}}
      </div>

      <div class="scan-stat-item" data-tooltip="lancer.common.stat.structure.label">
        <div class="scan-stat-header">
          <i class="cci cci-structure"></i>
        </div>
        {{stats.structure}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.hp.max.label">
        <div class="scan-stat-header">
          <i class="mdi mdi-heart-outline"></i>
        </div>
        {{stats.hp}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.evasion.label">
        <div class="scan-stat-header">
          <i class="cci cci-evasion"></i>
        </div>
        {{stats.evasion}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.armor.label">
        <div class="scan-stat-header">
          <i class="mdi mdi-shield-outline"></i>
        </div>
        {{stats.armor}}
      </div>

      <div class="scan-stat-item" data-tooltip="lancer.common.stat.stress.label">
        <div class="scan-stat-header">
          <i class="cci cci-reactor"></i>
        </div>
        {{stats.stress}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.heat.cap.label">
        <div class="scan-stat-header">
          <i class="cci cci-heat"></i>
        </div>
        {{stats.heat}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.eDefense.label">
        <div class="scan-stat-header">
          <i class="cci cci-edef"></i>
        </div>
        {{stats.edef}}
      </div>
      <div class="scan-stat-item stat-size" data-tooltip="{{localize "lancer.common.stat.size.label"}} {{stats.size}}" style="grid-area: size">
        {{#if (eq stats.size 0.5)}}
          <i class="cci cci-size-half"></i>
        {{else}}
          <i class="cci cci-size-{{stats.size}}"></i>
        {{/if}}
      </div>

      <div class="scan-stat-item" data-tooltip="lancer.common.stat.speed.label">
        <div class="scan-stat-header">
          <i class="mdi mdi-arrow-right-bold-hexagon-outline"></i>
        </div>
        {{stats.speed}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.save.target.label">
        <div class="scan-stat-header">
          <i class="cci cci-save"></i>
        </div>
        {{stats.save}}
      </div>
      <div class="scan-stat-item" data-tooltip="lancer.common.stat.sensor.range.label">
        <div class="scan-stat-header">
          <i class="cci cci-sensor"></i>
        </div>
        {{stats.sensor_range}}
      </div>
    </div>
  </div>
  <div class="scan-weapon-tech-container flexrow">
    {{#if weapons}}
      <details open class="clipped-top scan-feature-list lancer-weapon lancer-border-weapon">
        <summary class="lancer-header">
          <i class="cci cci-weapon i--4"></i><span>{{{upper-case (localize "lancer.common.item.mechWeapon.plural")}}}</span><i class="mdi mdi-unfold-less-horizontal"></i>
        </summary>
        <ul>
          {{#each weapons as |weapon index|}}
            {{{scan-weapon-view weapon}}}
          {{/each}}
        </ul>
      </details>
    {{/if}}
    {{#if techAttacks}}
      <details open class="clipped-top scan-feature-list lancer-tech lancer-border-tech">
        <summary class="lancer-header">
          <i class="cci cci-system i--4"></i><span>{{{upper-case (localize "lancer.common.stat.tech.attack.plural")}}}</span><i class="mdi mdi-unfold-less-horizontal"></i>
        </summary>
        <ul>
          {{#each techAttacks as |techAttack index|}}
            {{{scan-tech-attack-view techAttack}}}
          {{/each}}
        </ul>
      </details>
    {{/if}}
  </div>
  {{#if systems}}
    <details open class="clipped-top scan-feature-list lancer-system lancer-border-system">
      <summary class="lancer-header">
        <i class="cci cci-system i--4"></i><span>{{{upper-case (localize "lancer.common.item.mechSystem.plural")}}}</span><i class="mdi mdi-unfold-less-horizontal"></i>
      </summary>
      <ul>
        {{#each systems as |system index|}}
          {{{scan-system-view system}}}
        {{/each}}
      </ul>
    </details>
  {{/if}}
  {{#if traits}}
    <details open class="clipped-top scan-feature-list lancer-trait lancer-border-trait">
      <summary class="lancer-header">
        <i class="cci cci-trait i--4"></i><span>{{{upper-case (localize "lancer.common.descriptor.trait.plural")}}}</span><i class="mdi mdi-unfold-less-horizontal"></i>
      </summary>
      <ul>
        {{#each traits as |trait index|}}
          {{{scan-system-view trait}}}
        {{/each}}
      </ul>
    </details>
  {{/if}}
</div>
