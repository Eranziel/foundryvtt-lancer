<section class="llp-override-editor">
  <h3>{{localize "lancer.setting.localization.header.override.label"}}</h3>
  {{#if packs.length}}
    {{#each packs as |entry|}}
      <div>
        <details data-pack="{{entry.pack}}">
          <summary>
            <div class="llp-override-header flexrow">
              <div><strong>{{entry.pack}}</strong> ({{entry.rows.length}})</div>
              <div class="form-footer">
                <input type="file" data-field="import" accept="application/json,.json" hidden>
                <button type="button" data-action="addOverride"><i class="fas fa-plus"></i> {{localize "lancer.setting.localization.buttons.add.label"}}</button>
                <button type="button" data-action="importOverrides"><i class="fas fa-file-import"></i> {{localize "lancer.setting.localization.buttons.import.label"}}</button>
                <button type="button" data-action="exportOverrides"><i class="fas fa-file-export"></i> {{localize "lancer.setting.localization.buttons.export.label"}}</button>
              </div>
            </div>
          </summary>
          <div class="llp-override-grid-headers">
            <div class="llp-override-grid-header">{{localize "lancer.setting.localization.override.systemKey.label"}}</div>
            <div class="llp-override-grid-header">{{localize "lancer.setting.localization.override.llpKey.label"}}</div>
            <div></div>
          </div>
          <div class="llp-override-grid">
            <div class="llp-override-rows">
            {{#each entry.rows as |row|}}
              <div class="llp-override-row">
                <input type="text" data-field="destination" value="{{row.destination}}" placeholder="{{localize "lancer.setting.localization.override.systemKey.placeholder"}}">
                <input type="text" data-field="source" value="{{row.source}}" placeholder="{{localize "lancer.setting.localization.override.llpKey.placeholder"}}">
                <button type="button" class="llp-remove-override" data-action="removeOverride">
                  <i class="fas fa-trash"></i>
                </button>
                <div class="llp-translation-container"><!--
              ---><code class="llp-translation-text">{{row.translation}}</code><!--
            ---></div>
              </div>
            {{/each}}
            </div>
          </div>
          <!--Templates-->
          <template>
            <div class="llp-override-row">
              <input type="text" data-field="destination" placeholder="{{localize "lancer.setting.localization.override.systemKey.placeholder"}}">
              <input type="text" data-field="source" placeholder="{{localize "lancer.setting.localization.override.llpKey.placeholder"}}">
              <button type="button" class="llp-remove-override" data-action="removeOverride"
                data-tooltip="Remove override"><i class="fas fa-trash"></i></button>
              <div class="llp-translation-container"><code class="llp-translation-text"></code></div>
            </div>
          </template>
          <!---->
        </details>
      </div>
    {{/each}}
  {{else}}
    <p class="notes">{{localize "lancer.setting.localization.override.none.label"}}</p>
  {{/if}}
  <hr>
  <p>{{localize "lancer.setting.localization.header.override.hint"}}</p>
  <p data-tooltip="{{localize "lancer.setting.localization.override.consoleTip.tooltip"}}">
    <i class="mdi mdi-help-circle-outline"></i> {{{localize "lancer.setting.localization.override.consoleTip.label"}}}
  </p>
  <p data-tooltip="{{localize "lancer.setting.localization.override.commaTip.tooltip"}}">
    <i class="mdi mdi-help-circle-outline"></i> {{{localize "lancer.setting.localization.override.commaTip.label"}}}
  </p>
  <p class="flexrow"><span><i class="mdi mdi-help-circle-outline"></i> {{localize "lancer.setting.localization.override.llpPathTip.label"}}</span><code>ms_clamp_bombs.deployable_clamp_bombs.name</code></p>
  <p class="flexrow"><span><i class="mdi mdi-help-circle-outline"></i> {{localize "lancer.setting.localization.override.systemPathTip.label"}}</span><code>ms_clamp_bombs.system.actions.0.name</code></p>

</section>
